    {
      "scope": "tutorial",
      "title": "16 · 主动打开的基础操作帮助",
      "source": "src/content/presentation/tutorial/battle-basics.json",
      "sourceSha256": "52d05813d1bd7538701047d840d7aa265cf4c6458515100ac0bf0ed5b1ac48b9",
      "entries": [
        {
          "key": "/steps/intent/title",
          "node": "battle.basics",
          "text": "先看敌方意图"
        },
        {
          "key": "/steps/intent/text",
          "node": "battle.basics",
          "text": "图标表示敌人这一轮准备做什么。攻击意图会显示伤害与目标，格挡只作用于其中一条攻击。"
        },
        {
          "key": "/steps/roll/title",
          "node": "battle.basics",
          "text": "掷出行动"
        },
        {
          "key": "/steps/roll/text",
          "node": "battle.basics",
          "text": "点击 ROLL，掷出每位队员这一轮的骰面。"
        },
        {
          "key": "/steps/fix/title",
          "node": "battle.basics",
          "text": "留下需要的骰面"
        },
        {
          "key": "/steps/fix/text",
          "node": "battle.basics",
          "text": "点击骰子将它固定。也可以先重掷，寻找更合适的面。"
        },
        {
          "key": "/steps/actor/title",
          "node": "battle.basics",
          "text": "选择行动的队员"
        },
        {
          "key": "/steps/actor/text",
          "node": "battle.basics",
          "text": "骰面已固定。点击这位队员的立绘，再选择行动目标。"
        },
        {
          "key": "/steps/attack/title",
          "node": "battle.basics",
          "text": "选择敌人"
        },
        {
          "key": "/steps/attack/text",
          "node": "battle.basics",
          "text": "点击可选敌人执行当前攻击。击倒敌人后，它的意图也会消失。"
        },
        {
          "key": "/steps/guard/title",
          "node": "battle.basics",
          "text": "挡住这一次攻击"
        },
        {
          "key": "/steps/guard/text",
          "node": "battle.basics",
          "text": "点击攻击意图进行格挡。若队友受到多条攻击，需要分别应对。"
        },
        {
          "key": "/steps/heal/title",
          "node": "battle.basics",
          "text": "恢复队友"
        },
        {
          "key": "/steps/heal/text",
          "node": "battle.basics",
          "text": "点击受伤且仍存活的队友。普通治疗不能复活力竭者。"
        },
        {
          "key": "/steps/bind/title",
          "node": "battle.basics",
          "text": "选择提线目标"
        },
        {
          "key": "/steps/bind/text",
          "node": "battle.basics",
          "text": "点击可选敌人使用当前动作。只有满足条件的目标可以被提线。"
        },
        {
          "key": "/steps/reroll/title",
          "node": "battle.basics",
          "text": "重掷其余骰子"
        },
        {
          "key": "/steps/reroll/text",
          "node": "battle.basics",
          "text": "当前没有可用的行动目标。可以重掷未固定的骰子，或调整已经固定的面。"
        },
        {
          "key": "/steps/end/title",
          "node": "battle.basics",
          "text": "安排好后结束回合"
        },
        {
          "key": "/steps/end/text",
          "node": "battle.basics",
          "text": "还可以继续使用其他队员。准备好后点击 END TURN，结算牌型、铭约与剩余敌方意图。"
        },
        {
          "key": "/steps/next/title",
          "node": "battle.basics",
          "text": "开始下一轮"
        },
        {
          "key": "/steps/next/text",
          "node": "battle.basics",
          "text": "用过的清醒骰仍参与上一轮成牌；沉眠与力竭会被排除。接下来可以自行安排战斗。"
        }
      ]
    }
