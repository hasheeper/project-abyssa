{
  "schemaVersion": 1,
  "id": "chapter.tide-cave.final",
  "title": "雾滩·退潮岩窟",
  "locale": "zh-CN",
  "presentation": {
    "stagePreset": "rp-stage",
    "backgroundId": "tide-cave.shore",
    "defaultMode": "adv",
    "allowRp": false,
