{
  "name": "@abyssa/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Composable retro RPG interface components for Abyssa.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/abyssa-ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "dev:battle": "vite --config vite.battle.config.ts",
    "dev:dice": "vite --config vite.dice.config.ts",
    "setup:dice-runtime": "node scripts/setup-dice-runtime-application.mjs",
    "dev:map": "vite --config vite.map.config.ts",
    "dev:mansion": "vite --config vite.mansion.config.ts",
    "dev:mansion-editor": "vite --config vite.mansion-editor.config.ts",
    "dev:shop": "vite --config vite.shop.config.ts",
    "dev:character-status": "vite --config vite.character-status.config.ts",
    "dev:novel": "vite --config vite.novel.config.ts",
    "dev:rp": "vite --config vite.rp.config.ts",
    "dev:studio": "vite --config vite.studio.config.ts",
    "preview:components": "npm run build:preview && vite static-preview",
    "preview:character-status": "vite preview --config vite.character-status.config.ts",
    "preview:battle": "vite preview --config vite.battle.config.ts",
    "preview:dice": "vite preview --config vite.dice.config.ts",
    "preview:map": "vite preview --config vite.map.config.ts",
    "preview:mansion": "vite preview --config vite.mansion.config.ts",
    "preview:shop": "vite preview --config vite.shop.config.ts",
    "preview:novel": "vite preview --config vite.novel.config.ts",
    "preview:rp": "vite preview --config vite.rp.config.ts",
    "preview:studio": "vite preview --config vite.studio.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:battle": "vite build --config vite.battle.config.ts",
    "build:dice": "vite build --config vite.dice.config.ts",
    "build:map": "vite build --config vite.map.config.ts",
    "build:mansion": "vite build --config vite.mansion.config.ts",
    "build:mansion-editor": "vite build --config vite.mansion-editor.config.ts",
    "build:shop": "vite build --config vite.shop.config.ts",
    "build:character-status": "vite build --config vite.character-status.config.ts",
    "build:novel": "vite build --config vite.novel.config.ts",
    "build:rp": "vite build --config vite.rp.config.ts",
    "build:studio": "vite build --config vite.studio.config.ts",
    "build:preview": "node scripts/build-static-preview.mjs",
    "icons:sync": "node scripts/sync-game-icons.mjs",
    "icons:check": "node scripts/sync-game-icons.mjs --check",
    "emotes:build": "node scripts/build-emotes.mjs",
    "emotes:check": "node scripts/build-emotes.mjs --check",
    "pack:setting": "node scripts/pack-settings.mjs",
    "boundaries:check": "node scripts/check-module-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.128.0",
    "@vitejs/plugin-react": "^6.0.3",
    "gsap": "^3.12.2",
    "jsdom": "^27.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.4.6",
    "three": "^0.128.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^3.2.7"
  }
}
