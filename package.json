    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir dist/storybook",
    "dev:game": "node scripts/run-target.mjs dev game",
    "build:game": "node scripts/run-target.mjs build game",
    "preview:game": "node scripts/run-target.mjs preview game",
    "dev:lab": "node scripts/run-target.mjs dev lab",
