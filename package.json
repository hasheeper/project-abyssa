{
  "name": "@abyssa/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Composable retro RPG interface components for Abyssa.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/ui/index.js",
  "module": "./dist/ui/index.js",
  "types": "./dist/ui/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./branding": {
      "types": "./dist/ui/branding.d.ts",
      "import": "./dist/ui/branding.js"
    },
    "./patterns": {
      "types": "./dist/ui/patterns.d.ts",
      "import": "./dist/ui/patterns.js"
    },
    "./primitives": {
      "types": "./dist/ui/primitives.d.ts",
      "import": "./dist/ui/primitives.js"
    },
    "./styles.css": "./dist/ui/abyssa-ui.css"
  },
  "files": [
    "dist/ui"
  ],
  "scripts": {
    "dev": "node scripts/run-target.mjs dev entry:catalog",
