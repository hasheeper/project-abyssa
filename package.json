    "build:ui": "node scripts/run-target.mjs build ui",
    "build:all": "node scripts/run-target.mjs build all",
    "build:entries": "node scripts/check-entry-builds.mjs",
    "check:auxiliary": "node scripts/check-auxiliary.mjs",
    "release:check:ui": "npm run build:ui && node scripts/check-package-release.mjs",
    "release:check:game": "npm run build:game && npm run check:output -- game && npm run test:smoke -- --project=game",
    "check:entries": "node scripts/check-entries.mjs",
    "check:output": "node scripts/check-build-output.mjs",
    "typecheck:app": "tsc --noEmit",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json --noEmit",
    "test:build": "node --test tests/build/*.test.mjs",
    "test:smoke": "playwright test --config config/playwright.config.ts",
    "check:baseline": "npm run typecheck && npm run check:entries && npm run boundaries:check && npm test && npm run test:build && npm run check:core:import",
    "typecheck:core": "tsc -p tsconfig.game-core.json --noEmit",
    "test:core": "vitest run --project core",
    "test:app": "vitest run --project app",
    "check:core:import": "node scripts/check-core-import.mjs",
    "check:core": "npm run typecheck:core && npm run boundaries:check && npm run test:core && npm run check:core:import",
    "typecheck:application": "tsc -p tsconfig.game-application.json --noEmit",
    "test:application": "vitest run --project application",
    "check:application": "npm run typecheck:application && npm run boundaries:check && npm run test:application",
    "test:storage": "npm run test:smoke -- --project=storage"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.15",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.128.0",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "0.28.1",
    "gsap": "^3.12.2",
    "jsdom": "^27.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.4.6",
    "three": "^0.128.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8"
}
