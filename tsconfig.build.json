{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/index.ts", "src/shared/lib/**/*.ts", "src/shared/ui/**/*.ts", "src/shared/ui/**/*.tsx"],
  "exclude": ["src/**/*.test.*", "src/**/*.stories.*", "src/apps/catalog"]
}
