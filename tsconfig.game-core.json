{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src/game-core/**/*.ts"],
  "exclude": ["src/game-core/**/*.test.ts", "src/game-core/**/*.bench.ts", "src/game-core/**/testing/**"]
}
